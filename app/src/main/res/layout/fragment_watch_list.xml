<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
  >

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@drawable/gradient_background"
      tools:context=".presentation.watchlist.WatchListFragment">

    <TextView
        android:id="@+id/fragment_watch_list_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        android:text="@string/watchlist_placeholder"
        android:textColor="@color/white"
        android:gravity="center"
        android:textSize="15sp"
        android:fontFamily="@font/montserrat_light"
        android:visibility="gone"
        />


    <LinearLayout
        android:id="@+id/fragment_watch_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:orientation="horizontal">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_85sdp"
            android:background="@drawable/gradient_top" />

        <TextView
            android:id="@+id/fragment_watch_list_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_medium"
            android:gravity="start"
            android:paddingStart="@dimen/_15sdp"
            android:paddingTop="@dimen/_12sdp"
            android:paddingBottom="@dimen/_18sdp"
            android:text="@string/watch_list"
            android:textColor="@color/white"
            android:textSize="@dimen/_20ssp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fragment_watch_list_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/fragment_watch_list_tv"
            android:layout_marginTop="6dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:spanCount="@integer/grid_span_count"

            />
      </RelativeLayout>

      <TextView
          android:id="@+id/tvNoResult"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/no_result_found"
          android:textSize="16sp"
          android:fontFamily="@font/montserrat_medium"
          android:textColor="@android:color/white"
          android:gravity="center"
          android:visibility="gone"
          android:layout_gravity="center"/>


    </LinearLayout>

    <View
        android:id="@+id/peekingShelf"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone"
        tools:visibility="visible"
        />

    <ImageView
        android:id="@+id/peekingLogo"
        android:layout_width="165dp"
        android:layout_height="165dp"
        android:src="@drawable/logo_6"
        app:layout_constraintBottom_toTopOf="@id/peekingShelf"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-6dp"
        android:layout_marginStart="-25dp"
        android:visibility="gone"
        tools:visibility="visible"
        />

  </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
